# Copie este arquivo para ".env" (na pasta de onde o Tomcat é iniciado) e preencha os valores.
# O ".env" não vai para o GitHub. No Render, cadastre as mesmas chaves em "Environment".

# Banco de dados
POSTGRES_URL=jdbc:postgresql://localhost:5432/skadi_primeiro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# E-mail da equipe (recuperação de senha e "Contate-nos")
EMAIL_USER=skadi.enterprise@gmail.com
EMAIL_PASS=

# Link da área restrita na AWS (botão "Área restrita" do rodapé).
# É lido a cada clique: ao trocar o link aqui, não é preciso reiniciar o servidor.
AWS_URL_AREA_RESTRITA=https://
