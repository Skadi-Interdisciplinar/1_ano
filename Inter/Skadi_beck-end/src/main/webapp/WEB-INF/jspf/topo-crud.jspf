<%--
  Cabeçalho e menu lateral das telas de cadastro.
  Antes de incluir, a página precisa declarar o taglib "c" e a tela atual:
      <c:set var="paginaAtual" value="usuario"/>
  Valores: usuario | frigorifico | termometro | categoria | lote | endereco
  O gestor só visualiza: "somenteLeitura" esconde os botões de cadastrar, editar e deletar.
--%>
<c:set var="somenteLeitura" value="${sessionScope.usuarioLogado.nivelAcesso == 'gestor'}"/>
    <header class="topo">
        <button type="button" class="topo__menu" data-guia-botao aria-expanded="false" aria-controls="guia" aria-label="Abrir menu">
            <span></span><span></span><span></span>
        </button>

        <h1 class="topo__titulo">
            <span class="topo__titulo-prefixo">Você está analisando o </span><strong data-unidade-atual><c:out value="${sessionScope.cdAtualNome}" default="CD Skadi"/></strong>
        </h1>

        <a class="topo__logo" href="${pageContext.request.contextPath}/landing.jsp" aria-label="SKADI">
            <svg class="icone-logo"><use href="#icone-logo"/></svg>
        </a>
    </header>

    <nav class="guia" id="guia" data-guia aria-label="Menu das áreas de cadastro">
        <ul class="guia__lista">
            <li><a class="guia__item" href="${pageContext.request.contextPath}/usuario?acao=listar"<c:if test="${paginaAtual == 'usuario'}"> aria-current="page"</c:if>>FUNCIONÁRIOS</a></li>
            <li><a class="guia__item" href="${pageContext.request.contextPath}/frigorifico?acao=listar"<c:if test="${paginaAtual == 'frigorifico'}"> aria-current="page"</c:if>>FRIGORÍFICOS</a></li>
            <li><a class="guia__item" href="${pageContext.request.contextPath}/termometro?acao=listar"<c:if test="${paginaAtual == 'termometro'}"> aria-current="page"</c:if>>TERMÔMETROS</a></li>
            <li><a class="guia__item" href="${pageContext.request.contextPath}/categoria?acao=listar"<c:if test="${paginaAtual == 'categoria'}"> aria-current="page"</c:if>>CATEGORIAS</a></li>
            <li><a class="guia__item" href="${pageContext.request.contextPath}/lote?acao=listar"<c:if test="${paginaAtual == 'lote'}"> aria-current="page"</c:if>>LOTES</a></li>
            <li><a class="guia__item" href="${pageContext.request.contextPath}/endereco?acao=listar"<c:if test="${paginaAtual == 'endereco'}"> aria-current="page"</c:if>>ENDEREÇOS</a></li>
        </ul>

        <div class="guia__rodape">
            <a class="guia__unidade" href="${pageContext.request.contextPath}/cd?acao=listar">Mudar de unidade</a>
            <a class="guia__sair" href="${pageContext.request.contextPath}/login?acao=sair">Sair</a>
        </div>
    </nav>
    <div class="guia__fundo" data-guia-fundo></div>
