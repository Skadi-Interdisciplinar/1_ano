<%--
  Mensagem de erro das listas. Os servlets voltam para a lista com ?erro=<codigo>
  quando não conseguem gravar ou excluir.
--%>
            <c:if test="${not empty param.erro}">
                <p class="aviso-erro" role="alert">
                    <c:choose>
                        <c:when test="${param.erro == 'exclusao'}">Não foi possível deletar o registro. Ele pode já ter sido removido.</c:when>
                        <c:when test="${param.erro == 'banco'}">Não foi possível salvar no banco de dados. Tente novamente.</c:when>
                        <c:otherwise>Não foi possível concluir a operação.</c:otherwise>
                    </c:choose>
                </p>
            </c:if>
