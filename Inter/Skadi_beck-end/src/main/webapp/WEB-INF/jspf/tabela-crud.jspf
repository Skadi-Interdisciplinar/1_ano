<%--
  Cartão com pesquisa, botão "+", tabela e paginação (montados pelo crud.js).
  Antes de incluir, a página define:
      <c:set var="rotuloPlural" value="funcionários"/>   (texto do leitor de tela)
      <c:set var="rotuloNovo" value="Cadastrar novo funcionário"/>
--%>
    <main class="conteudo" data-crud>
        <section class="cartao" aria-label="Lista de ${rotuloPlural}">

            <div class="ferramentas">
                <div class="pesquisa">
                    <span class="pesquisa__icone" data-icone="search"></span>
                    <label class="so-leitor" for="pesquisa">Pesquisar ${rotuloPlural}</label>
                    <input class="pesquisa__campo" id="pesquisa" type="search" placeholder="Pesquisar..." autocomplete="off" data-crud-pesquisa>
                </div>

                <button type="button" class="botao-adicionar" data-crud-adicionar aria-label="${rotuloNovo}">
                    <span data-icone="adicionar"></span>
                </button>
            </div>

            <div class="tabela" data-crud-tabela>
                <div class="tabela__interna" role="table" aria-label="${rotuloPlural}">
                    <div class="tabela__cabeca" role="row" data-crud-cabeca></div>
                    <div class="tabela__corpo" role="rowgroup" data-crud-corpo></div>
                </div>
            </div>

            <div class="paginacao">
                <span data-crud-intervalo aria-live="polite">0 - 0 de 0</span>
                <button type="button" class="paginacao__botao" data-crud-anterior aria-label="Página anterior">
                    <span data-icone="chevL"></span>
                </button>
                <button type="button" class="paginacao__botao" data-crud-proxima aria-label="Próxima página">
                    <span data-icone="chevR"></span>
                </button>
            </div>

        </section>
    </main>
